# ===== 应用 =====
APP_ENV=dev
APP_NAME=mall-backend
APP_DEBUG=true
# traceId 注入前缀
TRACE_ID_PREFIX=mall

# ===== 安全 =====
# 生产环境务必更换，且不要提交真实值
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
# access token 有效期(秒)，默认 2 小时
JWT_ACCESS_EXPIRE=7200
# refresh token 有效期(秒)，默认 7 天
JWT_REFRESH_EXPIRE=604800
# BCrypt cost
BCRYPT_ROUNDS=10

# ===== 数据库 (MySQL 8.0) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=mall
# SQLAlchemy 同步连接串(Celery/迁移用)，本地用 pymysql 驱动
DATABASE_URL=mysql+pymysql://root:root123@127.0.0.1:3306/mall?charset=utf8mb4

# 用户小程序微信登录（真实环境由租户 pf_tenant.wx_appid/wx_secret_enc 提供）
# 默认必须走微信官方 code2session；本地契约测试才显式开启 fake，且 code 需为 fake:<id>。
WECHAT_LOGIN_FAKE_ENABLED=false
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_CODE2SESSION_TIMEOUT_SECONDS=5
# AES-256-GCM 字段加密密钥；生产必须独立安全注入，勿提交。
WECHAT_SECRET_ENCRYPT_KEY=

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0
# Token 黑名单 db
REDIS_BLACKLIST_DB=1
# 幂等键 TTL(秒)
IDEMPOTENCY_TTL=300
